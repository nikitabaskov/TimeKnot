# Server copy of the environment. Lives at /etc/timeknot/timeknot.env, mode 0600,
# owned by root — the service reads it through EnvironmentFile before dropping to
# the `timeknot` user. Never commit the filled-in version.
#
# systemd parses this file itself: no `export`, no quotes needed, no shell
# expansion. A value runs to the end of the line.

# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to talk to the bot. Everyone else is
# ignored silently.
OWNER_USER_IDS=

# Key from openrouter.ai/keys.
OPENROUTER_API_KEY=

# Model id from openrouter.ai/models. Free `:free` variants have daily limits and
# get withdrawn, which a reminder bot cannot rely on.
OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional. Where the Bot API lives, scheme and host only. Set it to the Worker
# relay from deploy/worker/ on a host without IPv4 — api.telegram.org has no
# AAAA record. Defaults to https://api.telegram.org
# TELEGRAM_API_ORIGIN=

# Optional. Defaults to https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=

# Optional. IANA name, defaults to Asia/Krasnoyarsk. Decides how times are read
# from and shown to the owner; storage is always UTC.
# TIMEZONE=Asia/Krasnoyarsk

# Required on a server: keep the database in the systemd StateDirectory, outside
# the deploy directory, so updating the code never touches it.
DATABASE_PATH=/var/lib/timeknot/timeknot.db

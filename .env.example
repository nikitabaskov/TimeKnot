# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to talk to the bot
OWNER_USER_IDS=

# Key from openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id from openrouter.ai/models.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional. Bot API origin, scheme and host only. Points at the Worker relay in
# deploy/worker/ when the host has no IPv4. Defaults to https://api.telegram.org
TELEGRAM_API_ORIGIN=

# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Optional. IANA name, defaults to Asia/Krasnoyarsk
TIMEZONE=

# Optional. SQLite file, defaults to timeknot.db in the working directory.
# On a server this points outside the deploy directory — see deploy/timeknot.env.example
DATABASE_PATH=

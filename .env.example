# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to talk to the bot
OWNER_USER_IDS=

# Key from openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id from openrouter.ai/models. Use a paid model, not a `:free` variant —
# free models have daily limits and get withdrawn. Check current prices before starting.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Optional. IANA name, defaults to Asia/Krasnoyarsk
TIMEZONE=

# Optional. SQLite file, defaults to timeknot.db in the working directory
DATABASE_PATH=
